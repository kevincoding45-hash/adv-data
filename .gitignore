data/raw/
data/*.sqlite
data/*.sqlite-journal

# Generated output -- ~17,700 files, rebuilt on every run.
site/
site_preview/

# One-off file for creating the Cloudflare Pages project in the dashboard.
placeholder/

# Reference PDFs are large; extracted text is committed instead.
reference/*.pdf

*.log

.venv/
__pycache__/
*.py[cod]
